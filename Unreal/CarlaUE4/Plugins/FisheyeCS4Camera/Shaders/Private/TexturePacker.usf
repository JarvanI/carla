*/



[numthreads(32, 32, 1)]
void MainCS(
    uint3 GroupId : SV_GroupID,
    uint3 DispatchThreadId : SV_DispatchThreadID,
    uint3 GroupThreadId : SV_GroupThreadID)
{
    uint height, width;
    // 获取 InputTexture 的宽度和高度
    InputTexture[1].GetDimensions(width, height);
    uint2 pixelCoord = DispatchThreadId.xy;
    int baseIndex = (pixelCoord.y * width + pixelCoord.x) * TopNPixel;

    float4 colors[TopNPixel];
    int texidx[TopNPixel];
    int miplv[TopNPixel];
    int x[TopNPixel];
    int y[TopNPixel];
    float weight[TopNPixel];
    float weightsum = 0.0f;
    // Load panel IDs and coordinates
    [unroll]
    for (int i = 0; i < TopNPixel; ++i)
    {
        UnpackedValues tmp = UnpackFromInt32(SamplePanelID[baseIndex + i]);
        texidx[i] = tmp.texidx2;
        miplv[i] = tmp.miplv2;
        x[i] = tmp.x12;
        y[i] = tmp.y12;
        weight[i] = tmp.weight4;
        weightsum += weight[i];
    }

    [unroll]
    for (int j = 0; j < TopNPixel; ++j)
    {
        int idx = texidx[j];
        int mip = miplv[j];
        int px = x[j];
        int py = y[j];
        float w = weight[j];

        switch(idx)
        {
            case 0:
                //0:16x1
                colors[j] = InputTexture[1].Load(int3(px, py, mip)) * w;
                break;
            case 1:
                //1:8x2
                colors[j] = InputTexture[2].Load(int3(px, py, mip)) * w;
                break;
            case 2:
                //2:4x4
                colors[j] = InputTexture[3].Load(int3(px, py, mip)) * w;
                break;
            case 3:
                //3:2x8
                colors[j] = InputTexture[4].Load(int3(px, py, mip)) * w;  
                break;
            default:
                //as 16x1
                colors[j] = float4(0, 0, 0, 0);
                break;
        }
    }

    // Calculate average color
    float4 averageColor = float4(0, 0, 0, 0);
    [unroll]
    for (int k = 0; k < TopNPixel; ++k)
    {
        averageColor += colors[k];
    }
    RWOutputTexture[DispatchThreadId.xy] = averageColor / weightsum;
}