#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"


#define TopNPixel 4
Texture2D<float4> InputTexture[5];
RWTexture2D<float4> RWOutputTexture;
StructuredBuffer<int> SamplePanelID;


struct UnpackedValues {
    int texidx2;
    int miplv2;
    int x12;
    int y12;
    float weight4;
};

UnpackedValues UnpackFromInt32(int packed)
{
    UnpackedValues result;
    result.texidx2  = (packed >> 30) & 0x3;    // 2 bits
    result.miplv2   = (packed >> 28) & 0x3;    // 2 bits
    result.x12      = (packed >> 16) & 0xFFF;  // 12 bits
    result.y12      = (packed >> 4)  & 0xFFF;  // 12 bits
    result.weight4  = float(packed & 0xF) / 15.0;  // Convert 0-15 to 0.0-1.0
    return result;
}


