struct UnpackedValues {
    int texidx2;
    int x12;
    int y12;
    float weight6;
};

UnpackedValues UnpackFromInt32(int packed)
{
    UnpackedValues result;
    result.texidx2 = (packed >> 30) & 0x3;
    result.x12     = (packed >> 18) & 0xFFF;
    result.y12     = (packed >> 6)  & 0xFFF;
    result.weight6 = float(packed & 0x3F) / 63.0; // ✅ 用 6 位精度解码到 [0,1]
    return result;
