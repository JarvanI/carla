#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"


#define DXC_STATIC_DISPATCH_GRID_DIM 0
Texture2D<float4> InputTexture[6];
SamplerState InputTextureSampler;
RWTexture2D<float4> RWOutputTexture;
StructuredBuffer<int> PixelInCircle;
StructuredBuffer<int> SamplePanelID;
StructuredBuffer<int> SamplePanelCoord;
StructuredBuffer<float> SamplePanelBrightness;



[numthreads(32, 32, 1)]
void MainCS(
    uint3 GroupId : SV_GroupID,
    uint3 DispatchThreadId : SV_DispatchThreadID,
    uint3 GroupThreadId : SV_GroupThreadID)
{
    uint height, width;
    InputTexture[1].GetDimensions(width, height);
    uint2 pixelCoord = DispatchThreadId.xy;
    if(PixelInCircle[pixelCoord.y * width + pixelCoord.x] == 0)
    {
        return;
    }

    // SampleNum = 4
    float4 colors[16];
    int panelIDs[16];
    int panelX[16];
    int panelY[16];

    // Load panel IDs and coordinates
    [unroll]
    for (int i = 0; i < 16; ++i)
    {
        int index = (pixelCoord.y * 4 + i / 4) * (4 * width * 2) + 2 * (pixelCoord.x * 4 + i % 4);
        panelIDs[i] = SamplePanelID[index];
        panelX[i] = SamplePanelCoord[index * 2];
        panelY[i] = SamplePanelCoord[index * 2 + 1];
    }

    // Fetch colors based on panel IDs
    [unroll]
    for (int j = 0; j < 16; ++j)
    {
        int panelID = panelIDs[j];
        int px = panelX[j];
        int py = panelY[j];

        switch (panelID)
        {
        case -1:
            colors[j] = float4(0, 0, 0, 0);
            break;
        case 0:
            colors[j] = InputTexture[1].Load(int3(px, py, 0));
            break;
        case 1:
            colors[j] = InputTexture[4].Load(int3(px, py, 0));
            break;
        case 2:
            colors[j] = InputTexture[5].Load(int3(px, py, 0));
            break;
        case 3:
            colors[j] = InputTexture[2].Load(int3(px, py, 0));
            break;
        case 4:
            colors[j] = InputTexture[3].Load(int3(px, py, 0));
            break;
        default:
            colors[j] = float4(0, 0, 0, 0);
            break;
        }
    }

    // Calculate average color
    float4 averageColor = float4(0, 0, 0, 0);
    [unroll]
    for (int k = 0; k < 16; ++k)
    {
        averageColor += colors[k];
    }
    averageColor /= 16.0;

    RWOutputTexture[DispatchThreadId.xy] = averageColor;
}


/*
uint2 ThreadGroupTilingX(
    const uint2 dispatchGridDim,      // Dispatch调用的网格维度，通常从常量缓冲区传入
    const uint2 ctaDim,               // 线程组的维度，已知于HLSL中，例如：[numthreads(8, 8, 1)] -> uint2(8, 8)
    const uint maxTileWidth,          // 用户参数（N），推荐值：8, 16或32
    const uint2 groupThreadID,        // 线程组内的线程ID（SV_GroupThreadID）
    const uint2 groupId               // 线程组ID（SV_GroupID）
) {
    //表示一个完美平铺中包含的线程组数量
    const uint Number_of_CTAs_in_a_perfect_tile = maxTileWidth * dispatchGridDim.y;
    //表示完美平铺的数量，即调度网格在X方向上可以完全平铺的次数。
    const uint Number_of_perfect_tiles = dispatchGridDim.x / maxTileWidth;
    //表示所有完美平铺中包含的线程组总数
    const uint Total_CTAs_in_all_perfect_tiles = Number_of_perfect_tiles * maxTileWidth * dispatchGridDim.y;
    //将2D的线程组ID扁平化为1D索引，用于后续计算。
    const uint vThreadGroupIDFlattened = dispatchGridDim.x * groupId.y + groupId.x;

    //计算当前线程组所属的平铺ID和在当前平铺中的局部ID
    const uint Tile_ID_of_current_CTA = vThreadGroupIDFlattened / Number_of_CTAs_in_a_perfect_tile;
    const uint Local_CTA_ID_within_current_tile = vThreadGroupIDFlattened % Number_of_CTAs_in_a_perfect_tile;

    uint X_dimension_of_last_tile = dispatchGridDim.x % maxTileWidth;
    #ifdef DXC_STATIC_DISPATCH_GRID_DIM
    X_dimension_of_last_tile = max(1, X_dimension_of_last_tile);
    #endif

    uint is_last_tile = (Total_CTAs_in_all_perfect_tiles <= vThreadGroupIDFlattened);
    uint tile_width = is_last_tile ? X_dimension_of_last_tile : maxTileWidth;

    uint Local_CTA_ID_y_within_current_tile = Local_CTA_ID_within_current_tile / tile_width;
    uint Local_CTA_ID_x_within_current_tile = Local_CTA_ID_within_current_tile % tile_width;

    const uint Swizzled_vThreadGroupIDFlattened =
        Tile_ID_of_current_CTA * maxTileWidth +
        Local_CTA_ID_y_within_current_tile * dispatchGridDim.x +
        Local_CTA_ID_x_within_current_tile;

    uint2 SwizzledvThreadGroupID;
    SwizzledvThreadGroupID.y = Swizzled_vThreadGroupIDFlattened / dispatchGridDim.x;
    SwizzledvThreadGroupID.x = Swizzled_vThreadGroupIDFlattened % dispatchGridDim.x;

    uint2 SwizzledvThreadID;
    SwizzledvThreadID.x = ctaDim.x * SwizzledvThreadGroupID.x + groupThreadID.x;
    SwizzledvThreadID.y = ctaDim.y * SwizzledvThreadGroupID.y + groupThreadID.y;

    return SwizzledvThreadID.xy;
}


[numthreads(32, 32, 1)]
void MainCS(
    uint3 GroupId : SV_GroupID,
    uint3 DispatchThreadId : SV_DispatchThreadID,
    uint3 GroupThreadId : SV_GroupThreadID)
{
    uint height, width;
    InputTexture[1].GetDimensions(width, height);

    //确保即使宽度或高度不是 32 的倍数，也能正确地计算出需要的线程组数量。
    uint2 dispatchGridDim = uint2((width + 31) / 32, (height + 31) / 32);
    //每个线程组的尺寸为32x32个线程，因为许多 GPU 架构对 32 的倍数非常友好，可以充分利用硬件的计算资源。
    uint2 ctaDim = uint2(32, 32);
    //线程组平铺时的最大宽度
    uint maxTileWidth = 16;
    uint2 swizzledThreadID = ThreadGroupTilingX(dispatchGridDim, ctaDim, maxTileWidth, GroupThreadId.xy, GroupId.xy);

    uint2 pixelCoord = DispatchThreadId.xy;

    // SampleNum = 4
    float4 colors[16];
    int panelIDs[16];
    int panelX[16];
    int panelY[16];

    // Load panel IDs and coordinates
    [unroll]
    for (int i = 0; i < 16; ++i)
    {
        panelIDs[i] = SamplePanelID[(swizzledThreadID.y * 4 + i / 4) * (4 * width * 2) + 2 * (swizzledThreadID.x * 4 + i % 4) + 0];
        panelX[i] = SamplePanelCoord[(swizzledThreadID.y * 4 + i / 4) * (4 * width * 4) + 2 * (2 * (swizzledThreadID.x * 4 + i % 4) + 0) + 0];
        panelY[i] = SamplePanelCoord[(swizzledThreadID.y * 4 + i / 4) * (4 * width * 4) + 2 * (2 * (swizzledThreadID.x * 4 + i % 4) + 0) + 1];
    }

    [unroll]
    for (int j = 0; j < 16; ++j)
    {
        int panelID = panelIDs[j];
        int px = panelX[j];
        int py = panelY[j];

        switch (panelID)
        {
            case -1:
                colors[j] = float4(0, 0, 0, 0);
                break;
            case 0:
                colors[j] = InputTexture[1].Load(int3(px, py, 0));
                break;
            case 1:
                colors[j] = InputTexture[4].Load(int3(px, py, 0));
                break;
            case 2:
                colors[j] = InputTexture[5].Load(int3(px, py, 0));
                break;
            case 3:
                colors[j] = InputTexture[2].Load(int3(px, py, 0));
                break;
            case 4:
                colors[j] = InputTexture[3].Load(int3(px, py, 0));
                break;
            default:
                colors[j] = float4(0, 0, 0, 0);
                break;
        }
    }

    // Calculate average color
    float4 averageColor = float4(0, 0, 0, 0);
    [unroll]
    for (int k = 0; k < 16; ++k)
    {
        averageColor += colors[k];
    }
    averageColor /= 16.0;

    RWOutputTexture[DispatchThreadId.xy] = averageColor;
}
