#include "/Engine/Public/Platform.ush"
#include "/Engine/Private/Common.ush"


#define DXC_STATIC_DISPATCH_GRID_DIM 0
Texture2D<float4> InputTexture[6];
SamplerState InputTextureSampler;
RWTexture2D<float4> RWOutputTexture;
StructuredBuffer<int> PixelInCircle;
StructuredBuffer<int> SamplePanelID;
StructuredBuffer<int> SamplePanelCoord;
StructuredBuffer<float> SamplePanelBrightness;


int CalculatePixelRealIndex(int2 coord, int BlockSize, int width, int height) {
    int x = coord.x;
    int y = coord.y;

    // 计算当前像素所在的块的行和列
    int BlockRow = x / BlockSize;
    int BlockCol = y / BlockSize;

    // 计算每行的块数
    int BlocksPerRow = (width + BlockSize - 1) / BlockSize;
    int BlocksPerCol = (height + BlockSize - 1) / BlockSize;

    // 计算每行的完美块数
    int BlocksPerfectPerRow = width / BlockSize;
    int BlocksPerfectPerCol = height / BlockSize;

    //计算最末的不完美块长度和宽度
    int BlockUnperfectRow = width - BlocksPerfectPerRow * BlockSize;
    int BlockUnperfectCol = height - BlocksPerfectPerCol * BlockSize;

    // 计算当前像素所在块在 Buff 中的起始位置
    int BlockNumUpper = BlockCol * (BlocksPerfectPerRow * BlockSize * BlockSize + BlockUnperfectRow * BlockSize);
    int BlockNumLeft = (y/BlockSize == BlocksPerfectPerCol ? BlockUnperfectCol : BlockSize) * BlockSize * BlockRow;

    // 计算当前像素在块中的偏移量
    int ElementOffset = (x/BlockSize == BlocksPerfectPerRow ? BlockUnperfectRow : BlockSize) * (y % BlockSize) + (x % BlockSize);

    // 计算 Buff 中的最终下标
    int PixelIndex = BlockNumUpper + BlockNumLeft + ElementOffset;

    return PixelIndex;
}


[numthreads(32, 32, 1)]
void MainCS(
    uint3 GroupId : SV_GroupID,
    uint3 DispatchThreadId : SV_DispatchThreadID,
    uint3 GroupThreadId : SV_GroupThreadID)
{
    uint height, width;
    InputTexture[1].GetDimensions(width, height);
    uint2 pixelCoord = DispatchThreadId.xy;
    if(PixelInCircle[pixelCoord.y * width + pixelCoord.x] == 0)
    {
        return;
    }

    // SampleNum = 4
    float4 colors[16];
    int panelIDs[16];
    int panelX[16];
    int panelY[16];

    int PixelIndex = CalculatePixelRealIndex(pixelCoord, 32, width, height);
    int Pixelx = PixelIndex % width;
    int Pixely = PixelIndex / width;
    // Load panel IDs and coordinates
    [unroll]
    for (int i = 0; i < 16; ++i)
    {
        int2 samplecoord = int2(i % 4,i / 4);
        //int index = (pixelCoord.y * 4 + i / 4) * (4 * width * 2) + 2 * (pixelCoord.x * 4 + i % 4);
        int samplex = i % 4;
        int sampley = i / 4;
        int index = (Pixely * 4 + sampley) * (width * 4) + (Pixelx * 4 + samplex);
        panelIDs[i] = SamplePanelID[index * 2];
        panelX[i] = SamplePanelCoord[index * 4];
        panelY[i] = SamplePanelCoord[index * 4 + 1];
    }

    // Fetch colors based on panel IDs
    [unroll]
    for (int j = 0; j < 16; ++j)
    {
        int panelID = panelIDs[j];
        int px = panelX[j];
        int py = panelY[j];

        switch (panelID)
        {
        case -1:
            colors[j] = float4(0, 0, 0, 0);
            break;
        case 0:
            colors[j] = InputTexture[1].Load(int3(px, py, 0));
            break;
        case 1:
            colors[j] = InputTexture[4].Load(int3(px, py, 0));
            break;
        case 2:
            colors[j] = InputTexture[5].Load(int3(px, py, 0));
            break;
        case 3:
            colors[j] = InputTexture[2].Load(int3(px, py, 0));
            break;
        case 4:
            colors[j] = InputTexture[3].Load(int3(px, py, 0));
            break;
        default:
            colors[j] = float4(0, 0, 0, 0);
            break;
        }
    }

    // Calculate average color
    float4 averageColor = float4(0, 0, 0, 0);
    [unroll]
    for (int k = 0; k < 16; ++k)
    {
        averageColor += colors[k];
    }
    averageColor /= 16.0;

    RWOutputTexture[DispatchThreadId.xy] = averageColor;
}